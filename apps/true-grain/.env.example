# Copy to .env.local in THIS app. Never commit actual credentials.
# Use a verified public HTTPS domain and set SITE_PUBLISHED=true only after owner review.
SITE_URL=
SITE_PUBLISHED=false
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_ADDRESS_VERIFIED=false
# Resend API key; use secure hosting environment settings for production.
EMAIL_API_KEY=
ESTIMATE_TO_EMAIL=
# Must be a plain email address on your verified sender domain.
ESTIMATE_FROM_EMAIL=
